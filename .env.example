# ==============================================================================
# POWERPLAY CLUB — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and supply your values. NEVER commit .env to source control!
# ==============================================================================

# Staff Portal Admin Secret Key (used to unlock the staff dashboard & API)
POWERPLAY_ADMIN_KEY=your_secure_staff_secret_key_here

# Pending Reservation Expiry Window (in minutes, defaults to 15)
PENDING_EXPIRY_MINUTES=15

# WhatsApp Destination Phone Number (default: 919701167899)
WHATSAPP_PHONE=919701167899

# Allowed CORS Origins (comma-separated, or * for open development)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://powerplayclub.in

# Local Database Path (defaults to powerplay.db if DATABASE_URL is not set)
POWERPLAY_DB_PATH=powerplay.db

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL / EDGE FUNCTIONS (Optional for Supabase Cloud Deployment)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> Database / API

# PostgreSQL Direct Connection String (Pooler or Direct)
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Project URL
# SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (safe for client if using direct Supabase SDK)
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
